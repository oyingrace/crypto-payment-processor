# ==============================================================================
# Blockchain Payment Processor - Environment Configuration Example
# Copy this file to .env or .env.local and update with your actual values.
# ==============================================================================

# --- Server Settings ---
PORT=3000
HOST=0.0.0.0

# --- Security ---
# Secret key used for authenticating requests to API endpoints (Bearer token)
API_KEY=your_secret_api_key_here

# --- Active Blockchain Networks ---
# Comma-separated list of network listeners to start on launch.
# Available options: BEP20, BEP20_TESTNET
ACTIVE_NETWORKS=BEP20

# --- Blockchain Explorer API Keys ---
# Explorer API key used for BSC transaction queries and verification
BSCSCAN_API_KEY=your_bscscan_api_key_here

# --- Web3 / RPC Provider URLs ---
# HTTPS RPC endpoints for connecting to BSC
BSC_MAINNET_HTTPS_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_HTTPS_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# --- Recipient Wallet Addresses ---
# Destination wallet addresses where incoming payments will be monitored
RECIPIENT_ADDRESS_BNB_MAINNET=0xYourBscMainnetRecipientAddress
# General / testnet recipient address (used by BEP20_TESTNET)
RECIPIENT_ADDRESS=0xYourDefaultOrTestnetRecipientAddress

# --- Payment Verification & Filtering ---
# Target USDT amount to verify/detect (optional if passing dynamically via API/CLI)
TARGET_USDT_AMOUNT=1.00

# Specific sender wallet address to filter incoming transactions (optional)
SENDER_ADDRESS=

# Testnet token contract address for USDT on BSC Testnet (optional override)
USDT_CONTRACT_ADDRESS_TESTNET=0x337610d27c682E347C9cD60743731070adCE5659

# --- Payment Session Settings (Optional) ---
# Default duration for a payment session in minutes
DEFAULT_EXPIRATION_MINUTES=30

# Status polling interval in milliseconds
PAYMENT_STATUS_POLL_INTERVAL=10000

# --- Confirmation Requirements (Optional) ---
REQUIRED_CONFIRMATIONS_BEP20=10
REQUIRED_CONFIRMATIONS_BEP20_TESTNET=2

# --- Neon PostgreSQL Database Configuration (Optional) ---
# Paste your Neon DB connection string here. If omitted, storage falls back to in-memory mode.
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternatively, configure individual connection parameters:
# DB_HOST=ep-sample-123456.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your_password
